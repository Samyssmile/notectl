---
const DEVHUNT_URL: string = 'https://devhunt.org/tool/notectl';
---

<div class="devhunt-banner" data-pagefind-ignore>
	notectl is live on DevHunt's tool of the week contest.{' '}
	<a href={DEVHUNT_URL}>Vote for notectl on DevHunt<span aria-hidden="true"> →</span></a>
</div>

<style>
	.devhunt-banner {
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-banner-bg);
		color: var(--sl-color-banner-text);
		line-height: var(--sl-line-height-headings);
		text-align: center;
		text-wrap: balance;
		box-shadow: var(--sl-shadow-sm);
	}

	a {
		color: inherit;
		font-weight: 600;
	}

	a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
</style>
